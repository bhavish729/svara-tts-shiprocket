# ============================================================================
# Svara TTS API - Environment Configuration
# ============================================================================
# Copy this file to .env and customize the values for your deployment

# ============================================================================
# vLLM Configuration
# ============================================================================

# Model repository ID from Hugging Face
# Default: kenpath/svara-tts-v1
VLLM_MODEL=kenpath/svara-tts-v1

# vLLM server host and port
VLLM_HOST=0.0.0.0
VLLM_PORT=8000

# GPU memory utilization (0.0-1.0)
# Lower values leave more memory for other processes
# Recommended: 0.85 for H100 (leaves headroom for SNAC + activations)
VLLM_GPU_MEMORY_UTILIZATION=0.85

# Maximum model context length
# Adjust based on your GPU memory
VLLM_MAX_MODEL_LEN=2048

# Number of GPUs to use for tensor parallelism
# Set to 1 for single GPU, increase for multi-GPU setups
VLLM_TENSOR_PARALLEL_SIZE=1

# Trust remote code from model repository
# Required for models with custom code
VLLM_TRUST_REMOTE_CODE=true

# Continuous batching limits (H100 H100 80GB defaults)
# Raise these to absorb more concurrent requests; the bench script finds the ceiling.
VLLM_MAX_NUM_SEQS=64
VLLM_MAX_NUM_BATCHED_TOKENS=8192

# bfloat16 is the right call on H100 (sm_90); leave as auto for other GPUs.
VLLM_DTYPE=bfloat16

# Enable chunked prefill so long prompts don't block the decode loop.
VLLM_ENABLE_CHUNKED_PREFILL=true

# ============================================================================
# FastAPI Server Configuration
# ============================================================================

# FastAPI server host and port
API_HOST=0.0.0.0
API_PORT=8080

# vLLM base URL for API server to connect to
# Use http://localhost:8000/v1 for same-container deployment
VLLM_BASE_URL=http://localhost:8000/v1

# ============================================================================
# TTS Engine Configuration
# ============================================================================

# Device for SNAC decoder (cuda, mps, cpu, or auto)
TTS_DEVICE=cuda

# Worker threads in the SNAC decode pool. Each thread holds the SNAC lock for
# ~25ms on H100, so this only helps if SNAC decode and CPU-side work overlap.
TTS_DECODE_WORKERS=8

# Voice-agent latency tuning:
#   prebuffer_seconds=0.1 instead of 0.5 → drops ~250-300ms from TTFB on H100.
#     Safe with LiveKit/Daily/Twilio (they have their own jitter buffer); reduce
#     to 0.0 only if you really know the client tolerates raw chunked output.
#   pending_threshold=0 → yield each SNAC window as soon as it decodes, instead
#     of buffering 3 windows first.
TTS_PREBUFFER_SECONDS=0.1
TTS_PENDING_THRESHOLD=0

# ============================================================================
# Hugging Face Configuration
# ============================================================================

# Hugging Face API token (optional)
# Required for gated models or private repositories
HF_TOKEN=

# Path that weights are downloaded into and served from. On RunPod, set this to
# the mount path of a Network Volume so weights survive pod restarts.
HF_HOME=/workspace/models
HUGGINGFACE_HUB_CACHE=/workspace/models
TRANSFORMERS_CACHE=/workspace/models

# RunPod-specific: mount path of the 100GB Network Volume that holds weights.
RUNPOD_VOLUME_PATH=/workspace/models

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
